# ── Jira ─────────────────────────────────────────────────────────────────────
# Your Atlassian instance URL, e.g. https://yourcompany.atlassian.net
JIRA_BASE_URL=https://yourcompany.atlassian.net

# The email address you use to log into Jira
JIRA_EMAIL=you@yourcompany.com

# Jira API token — generate at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_jira_api_token

# The Jira project key where you'll create [AI-PIPELINE] stories
JIRA_PROJECT_KEY=AI

# ── Google Gemini (free via AI Studio) ───────────────────────────────────────
# Get a free API key at https://aistudio.google.com/app/apikey
# Default model: gemini-2.0-flash (free tier, no billing required)
GEMINI_API_KEY=AIza...

# Optional: override the model (e.g. gemini-1.5-flash for higher rate limits)
# GEMINI_MODEL=gemini-1.5-flash

# ── GitHub ────────────────────────────────────────────────────────────────────
# Personal access token with repo + workflow scopes
# Generate at https://github.com/settings/tokens
GITHUB_TOKEN=ghp_...

# Target repository in owner/repo format (must exist with at least one commit)
GITHUB_REPO=your-username/ai-pipeline-output

# ── Vercel ────────────────────────────────────────────────────────────────────
# Vercel API token from https://vercel.com/account/tokens
VERCEL_TOKEN=your_vercel_token

# Name for the Vercel project (will be created automatically on first deploy)
VERCEL_PROJECT_NAME=ai-pipeline-output

# ── Email ─────────────────────────────────────────────────────────────────────
# Sender address
EMAIL_FROM=pipeline@yourcompany.com

# Recipient for QA reports
EMAIL_TO=you@yourcompany.com

# Option A — SMTP (Gmail, SendGrid, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_app_password

# Option B — Resend (leave SMTP vars blank if using this)
# Sign up at https://resend.com and add your sending domain
# RESEND_API_KEY=re_...
